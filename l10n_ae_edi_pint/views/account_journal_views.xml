<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_account_journal_form_payment_instrument" model="ir.ui.view">
        <field name="name">account.journal.form.uae.payment.instrument</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='inbound_payment_method_line_ids']/list/field[@name='name'] | //field[@name='outbound_payment_method_line_ids']/list/field[@name='name']"
                position="after"
            >
                <field
                    name="l10n_ae_edi_payment_means_code"
                    column_invisible="parent.country_code != 'AE'"
                />
            </xpath>
        </field>
    </record>
</odoo>
