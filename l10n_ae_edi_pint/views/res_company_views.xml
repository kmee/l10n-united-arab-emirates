<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_company_form_incoming_reviewer" model="ir.ui.view">
        <field name="name">res.company.form.uae.incoming.reviewer</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="l10n_ae_edi.res_company_form_uae_edi" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='l10n_ae_edi_auto_prepare']" position="after">
                <field
                    name="l10n_ae_inbox_reviewer_id"
                    groups="account.group_account_manager"
                    domain="[('active', '=', True), ('share', '=', False), ('company_ids', 'in', [id])]"
                    options="{'no_create': True}"
                />
            </xpath>
        </field>
    </record>
</odoo>
