<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="edi_audit_inbox_list" model="ir.ui.view">
        <field name="name">l10n_ae.edi.inbox.audit.list</field>
        <field name="model">l10n_ae.edi.inbox</field>
        <field name="priority" eval="30" />
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="remote_id" />
                <field name="company_id" options="{'no_open': True}" />
                <field name="received_at" />
                <field name="state" />
                <field name="xml_hash" />
            </list>
        </field>
    </record>
    <record id="edi_audit_inbox_form" model="ir.ui.view">
        <field name="name">l10n_ae.edi.inbox.audit.form</field>
        <field name="model">l10n_ae.edi.inbox</field>
        <field name="priority" eval="30" />
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false" duplicate="false">
                <sheet>
                    <group>
                        <field name="remote_id" />
                        <field name="company_id" options="{'no_open': True}" />
                        <field name="received_at" />
                        <field name="state" />
                        <field name="xml_hash" />
                        <field name="original_xml" />
                        <field name="identity_conflict" />
                        <field name="diagnostic" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="edi_audit_inbox_action" model="ir.actions.act_window">
        <field name="name">Received Documents</field>
        <field name="res_model">l10n_ae.edi.inbox</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="edi_audit_inbox_action_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1" />
        <field name="view_mode">list</field>
        <field name="view_id" ref="edi_audit_inbox_list" />
        <field name="act_window_id" ref="edi_audit_inbox_action" />
    </record>
    <record id="edi_audit_inbox_action_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2" />
        <field name="view_mode">form</field>
        <field name="view_id" ref="edi_audit_inbox_form" />
        <field name="act_window_id" ref="edi_audit_inbox_action" />
    </record>
    <menuitem
        id="edi_audit_inbox_menu"
        name="Received Documents"
        parent="l10n_ae_edi.edi_audit_root"
        action="edi_audit_inbox_action"
        sequence="1"
    />
</odoo>
