<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="edi_inbox_selection_form" model="ir.ui.view">
        <field name="name">l10n_ae.edi.inbox.selection.form</field>
        <field name="model">l10n_ae.edi.inbox.selection</field>
        <field name="arch" type="xml">
            <form string="Review Identity Variant">
                <div class="alert alert-info" role="alert">
                    Compare every retained original with the business evidence.
                    This selection records internal eligibility. It does not process,
                    post or acknowledge the document.
                </div>
                <group>
                    <field name="inbox_id" options="{'no_open': True}" />
                    <field name="company_id" invisible="1" />
                    <field name="xml_hash" class="text-wrap text-break" />
                </group>
                <field name="original_ids" readonly="1">
                    <list create="false" edit="false" delete="false">
                        <field name="id" string="Original ID" />
                        <field name="received_at" />
                        <field name="xml_hash" class="text-wrap text-break" />
                        <field name="move_id" />
                    </list>
                </field>
                <group>
                    <field name="justification" required="1" />
                    <field name="review_reference" required="1" />
                </group>
                <footer>
                    <button
                        name="action_confirm"
                        type="object"
                        string="Select This Original"
                        class="btn-primary"
                    />
                    <button special="cancel" string="Cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
