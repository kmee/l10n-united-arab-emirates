<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Dedicated receiver navigation uses existing ACLs and company rules. -->
    <record id="edi_receiver_inbox_list" model="ir.ui.view">
        <field name="name">l10n_ae.edi.inbox.receiver.list</field>
        <field name="priority" eval="90" />
        <field name="model">l10n_ae.edi.inbox</field>
        <field name="arch" type="xml">
            <list
                create="false"
                edit="false"
                delete="false"
                decoration-warning="state == 'review'"
            >
                <field name="remote_id" />
                <field name="binding_id" />
                <field name="received_at" />
                <field name="state" />
                <field name="xml_hash" />
            </list>
        </field>
    </record>
    <record id="edi_receiver_inbox_form" model="ir.ui.view">
        <field name="name">l10n_ae.edi.inbox.receiver.form</field>
        <field name="priority" eval="90" />
        <field name="model">l10n_ae.edi.inbox</field>
        <field name="arch" type="xml">
            <form
                string="Received UAE Document"
                create="false"
                edit="false"
                delete="false"
                duplicate="false"
            >
                <header>
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="received,review,processed"
                    />
                </header>
                <sheet>
                    <group>
                        <field name="remote_id" />
                        <field name="binding_id" options="{'no_open': True}" />
                        <field name="received_at" />
                        <field name="original_xml" />
                        <field name="xml_hash" class="text-wrap text-break" />
                        <field name="diagnostic" />
                    </group>
                    <!-- Intentionally excludes move_id, internal_review_task_ids,
                         decision wizards, review/process/accounting/export actions.
                         Child embedded forms exclude accounting/task relations too. -->
                    <group string="Delivery Event History" col="1">
                        <field name="ingestion_event_ids" readonly="1" nolabel="1">
                            <list create="false" edit="false" delete="false">
                                <field name="event_id" />
                                <field name="occurred_at" />
                                <field name="disposition" />
                            </list>
                            <form
                                create="false"
                                edit="false"
                                delete="false"
                                duplicate="false"
                            >
                                <group>
                                    <field name="event_id" />
                                    <field name="remote_id" />
                                    <field name="xml_hash" />
                                    <field name="occurred_at" />
                                    <field name="disposition" />
                                </group>
                            </form>
                        </field>
                    </group>
                    <group string="Processing History" col="1">
                        <field name="processing_history_ids" readonly="1" nolabel="1">
                            <list create="false" edit="false" delete="false">
                                <field name="occurred_at" />
                                <field name="outcome" />
                                <field name="diagnostic" />
                                <field name="xml_hash" />
                            </list>
                            <form
                                create="false"
                                edit="false"
                                delete="false"
                                duplicate="false"
                            >
                                <group>
                                    <field name="occurred_at" />
                                    <field name="outcome" />
                                    <field name="diagnostic" />
                                    <field name="xml_hash" />
                                </group>
                            </form>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="edi_receiver_inbox_action" model="ir.actions.act_window">
        <field name="name">Received UAE Documents</field>
        <field name="res_model">l10n_ae.edi.inbox</field>
        <field name="view_mode">list,form</field>
        <field
            name="view_ids"
            eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('edi_receiver_inbox_list')}), (0, 0, {'view_mode': 'form', 'view_id': ref('edi_receiver_inbox_form')})]"
        />
    </record>
    <menuitem
        id="edi_receiver_root_menu"
        name="UAE Document Receiving"
        groups="l10n_ae_edi_pint.group_document_receiver"
        sequence="92"
    />
    <menuitem
        id="edi_receiver_inbox_menu"
        name="Received UAE Documents"
        parent="edi_receiver_root_menu"
        action="edi_receiver_inbox_action"
        groups="l10n_ae_edi_pint.group_document_receiver"
        sequence="10"
    />
</odoo>
