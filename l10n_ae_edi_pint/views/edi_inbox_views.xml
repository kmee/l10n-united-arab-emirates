<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="edi_inbox_form" model="ir.ui.view">
        <field name="name">l10n_ae.edi.inbox.form</field>
        <field name="model">l10n_ae.edi.inbox</field>
        <field name="arch" type="xml">
            <form
                string="Received UAE Document"
                create="false"
                edit="false"
                delete="false"
            >
                <header>
                    <button
                        name="action_review_identity_variant"
                        type="object"
                        string="Review Identity Variant"
                        groups="account.group_account_manager"
                        invisible="not identity_conflict"
                    />
                    <button
                        name="action_review_event_conflict"
                        type="object"
                        string="Review Delivery Event Conflict"
                        groups="account.group_account_manager"
                        invisible="not ingestion_conflict"
                    />
                    <button
                        name="action_request_review"
                        type="object"
                        string="Request Internal Review"
                        groups="account.group_account_manager"
                        invisible="state == 'processed'"
                    />
                    <button
                        name="action_process"
                        type="object"
                        string="Process Received Document"
                        groups="account.group_account_manager"
                        invisible="state == 'processed' or identity_review_pending or event_review_pending"
                    />
                    <button
                        name="action_open_move"
                        type="object"
                        string="Open Accounting Document"
                        invisible="not move_id"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="received,review,processed"
                    />
                </header>
                <sheet>
                    <group>
                        <field name="remote_id" />
                        <field name="company_id" groups="base.group_multi_company" />
                        <field name="binding_id" />
                        <field name="received_at" />
                        <field name="original_xml" />
                        <field name="evidence_archive_filename" invisible="1" />
                        <field
                            name="evidence_archive"
                            filename="evidence_archive_filename"
                            readonly="1"
                            groups="base.group_allow_export"
                        />
                        <field name="xml_hash" class="text-wrap text-break" />
                        <field name="move_id" />
                        <field name="identity_conflict" />
                        <field name="ingestion_conflict" />
                        <field name="identity_review_pending" />
                        <field name="event_review_pending" />
                    </group>
                    <group string="Received Delivery" invisible="not delivery_summary">
                        <field name="delivery_summary" readonly="1" nolabel="1" />
                    </group>
                    <group string="Review Diagnostic" invisible="not diagnostic">
                        <field name="diagnostic" nolabel="1" />
                    </group>
                    <group
                        string="Received Invoice References"
                        col="1"
                        invisible="not credit_reference_summary"
                    >
                        <field
                            name="credit_reference_summary"
                            readonly="1"
                            nolabel="1"
                        />
                    </group>
                    <group string="Internal Review Request" col="1">
                        <field name="internal_review_task_ids" readonly="1" nolabel="1">
                            <list create="false" edit="false" delete="false">
                                <field name="state" />
                                <field name="requested_at" />
                                <field name="assigned_to_id" />
                                <field name="assigned_at" />
                                <field name="last_check_state" />
                            </list>
                        </field>
                    </group>
                    <group
                        string="Internal Identity Selections"
                        col="1"
                        invisible="not identity_conflict"
                    >
                        <field name="identity_decision_ids" readonly="1" nolabel="1">
                            <list create="false" edit="false" delete="false">
                                <field name="occurred_at" />
                                <field name="operator_id" options="{'no_open': True}" />
                                <field name="selected_inbox_id" />
                                <field name="review_reference" />
                            </list>
                            <form
                                create="false"
                                edit="false"
                                delete="false"
                                duplicate="false"
                            >
                                <group>
                                    <field name="occurred_at" />
                                    <field
                                        name="operator_id"
                                        options="{'no_open': True}"
                                    />
                                    <field name="selected_inbox_id" />
                                    <field name="selected_xml_hash" />
                                    <field name="justification" />
                                    <field name="review_reference" />
                                </group>
                                <field name="member_ids" readonly="1">
                                    <list create="false" edit="false" delete="false">
                                        <field name="id" string="Original ID" />
                                        <field
                                            name="xml_hash"
                                            class="text-wrap text-break"
                                        />
                                    </list>
                                </field>
                            </form>
                        </field>
                    </group>
                    <group
                        string="Internal Delivery Event Reviews"
                        col="1"
                        invisible="not ingestion_conflict"
                    >
                        <field name="event_decision_ids" readonly="1" nolabel="1">
                            <list create="false" edit="false" delete="false">
                                <field name="occurred_at" />
                                <field name="operator_id" options="{'no_open': True}" />
                                <field
                                    name="approved_inbox_ids"
                                    widget="many2many_tags"
                                />
                                <field name="review_reference" />
                            </list>
                            <form
                                create="false"
                                edit="false"
                                delete="false"
                                duplicate="false"
                            >
                                <group>
                                    <field name="occurred_at" />
                                    <field
                                        name="operator_id"
                                        options="{'no_open': True}"
                                    />
                                    <field name="member_ids" widget="many2many_tags" />
                                    <field
                                        name="approved_inbox_ids"
                                        widget="many2many_tags"
                                    />
                                    <field name="justification" />
                                    <field name="review_reference" />
                                </group>
                            </form>
                        </field>
                    </group>
                    <group string="Delivery Event History" col="1">
                        <field name="ingestion_event_ids" readonly="1" nolabel="1">
                            <list create="false" edit="false" delete="false">
                                <field name="event_id" />
                                <field name="remote_id" />
                                <field name="occurred_at" />
                                <field name="operator_id" options="{'no_open': True}" />
                                <field name="disposition" />
                            </list>
                            <form
                                create="false"
                                edit="false"
                                delete="false"
                                duplicate="false"
                            >
                                <group>
                                    <field name="event_id" />
                                    <field name="remote_id" />
                                    <field name="xml_hash" />
                                    <field name="occurred_at" />
                                    <field
                                        name="operator_id"
                                        options="{'no_open': True}"
                                    />
                                    <field name="disposition" />
                                    <field name="provider" />
                                    <field name="environment" />
                                    <field name="recipient_tin" />
                                </group>
                            </form>
                        </field>
                    </group>
                    <group string="Processing History" col="1">
                        <field name="processing_history_ids" readonly="1" nolabel="1">
                            <list create="false" edit="false" delete="false">
                                <field name="occurred_at" />
                                <field name="operator_id" options="{'no_open': True}" />
                                <field name="outcome" />
                                <field name="diagnostic" />
                                <field name="xml_hash" optional="hide" />
                            </list>
                            <form
                                create="false"
                                edit="false"
                                delete="false"
                                duplicate="false"
                            >
                                <group>
                                    <field name="occurred_at" />
                                    <field
                                        name="operator_id"
                                        options="{'no_open': True}"
                                    />
                                    <field name="outcome" />
                                    <field
                                        name="xml_hash"
                                        class="text-wrap text-break"
                                    />
                                    <field name="diagnostic" />
                                    <field name="validation_report_hash" />
                                    <field name="validation_report" />
                                </group>
                            </form>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="edi_inbox_list" model="ir.ui.view">
        <field name="name">l10n_ae.edi.inbox.list</field>
        <field name="model">l10n_ae.edi.inbox</field>
        <field name="arch" type="xml">
            <list
                create="false"
                edit="false"
                delete="false"
                decoration-warning="state == 'review'"
            >
                <field name="remote_id" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="binding_id" />
                <field name="received_at" />
                <field name="state" />
                <field name="move_id" />
            </list>
        </field>
    </record>
    <record id="edi_inbox_action" model="ir.actions.act_window">
        <field name="name">Received UAE Documents</field>
        <field name="res_model">l10n_ae.edi.inbox</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem
        id="edi_inbox_menu"
        name="Received UAE Documents"
        parent="account.menu_finance"
        action="edi_inbox_action"
        sequence="30"
        groups="account.group_account_invoice,account.group_account_readonly"
    />
</odoo>
