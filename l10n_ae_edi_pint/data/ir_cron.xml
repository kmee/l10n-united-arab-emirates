<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <record id="ir_cron_incoming_review" model="ir.cron">
        <field name="name">UAE: Received Document Internal Review</field>
        <field name="model_id" ref="model_l10n_ae_edi_inbox_task" />
        <field name="state">code</field>
        <field name="code">model._cron_incoming_review()</field>
        <field name="user_id" ref="base.user_admin" />
        <field
            name="group_ids"
            eval="[Command.link(ref('account.group_account_manager'))]"
        />
        <field name="interval_number" eval="1" />
        <field name="interval_type">hours</field>
        <field name="active" eval="False" />
    </record>
    <record id="ir_cron_controlled_receive" model="ir.cron">
        <field name="name">UAE: Controlled Document Receiving</field>
        <field name="model_id" ref="l10n_ae_edi.model_l10n_ae_edi_binding" />
        <field name="state">code</field>
        <field name="code">model._cron_receive_controlled()</field>
        <field name="user_id" ref="base.user_admin" />
        <field
            name="group_ids"
            eval="[Command.link(ref('group_document_receiver')), Command.link(ref('account.group_account_manager'))]"
        />
        <field name="interval_number" eval="1" />
        <field name="interval_type">minutes</field>
        <field name="active" eval="False" />
    </record>
</odoo>
