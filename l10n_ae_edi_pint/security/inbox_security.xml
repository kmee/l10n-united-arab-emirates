<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="edi_inbox_selection_original_rule" model="ir.access">
        <field name="name">UAE original identity review source isolation</field>
        <field name="model_id" ref="model_l10n_ae_edi_inbox_selection" />
        <field name="operation">crud</field>
        <field name="domain">[('inbox_id', 'access', 'read')]</field>
    </record>
    <record id="edi_inbox_decision_originals_rule" model="ir.access">
        <field name="name">UAE identity selection complete original isolation</field>
        <field name="model_id" ref="model_l10n_ae_edi_inbox_decision" />
        <field name="operation">crud</field>
        <field
            name="domain"
        >[('company_id', 'in', company_ids), ('member_ids', '!=', False)]</field>
    </record>
    <record id="edi_inbox_task_company_rule" model="ir.access">
        <field name="name">UAE received review company and original isolation</field>
        <field name="model_id" ref="model_l10n_ae_edi_inbox_task" />
        <field name="operation">crud</field>
        <field
            name="domain"
        >[('company_id', 'in', company_ids), ('inbox_id', 'access', 'read')]</field>
    </record>
    <record id="edi_inbox_company_rule" model="ir.access">
        <field name="name">UAE received document company isolation</field>
        <field name="model_id" ref="model_l10n_ae_edi_inbox" />
        <field name="operation">crud</field>
        <field name="domain">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="edi_inbox_review_company_rule" model="ir.access">
        <field name="name">UAE processing history company isolation</field>
        <field name="model_id" ref="model_l10n_ae_edi_inbox_review" />
        <field name="operation">crud</field>
        <field name="domain">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="edi_inbox_ingestion_original_rule" model="ir.access">
        <field name="name">UAE delivery event company and original isolation</field>
        <field name="model_id" ref="model_l10n_ae_edi_inbox_ingestion" />
        <field name="operation">crud</field>
        <field
            name="domain"
        >[('company_id', 'in', company_ids), ('inbox_id', 'access', 'read')]</field>
    </record>
</odoo>
