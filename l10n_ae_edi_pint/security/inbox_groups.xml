<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="privilege_uae_document_receiving" model="res.groups.privilege">
        <field name="name">UAE Document Receiving</field>
        <field name="category_id" ref="base.module_category_accounting" />
    </record>
    <record id="group_document_receiver" model="res.groups">
        <field name="name">Controlled Document Receiver</field>
        <field name="privilege_id" ref="privilege_uae_document_receiving" />
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
        <field
            name="comment"
        >Receive and preserve controlled UAE XML for authorized companies without accounting, sending or confirmation event permissions.</field>
    </record>
</odoo>
