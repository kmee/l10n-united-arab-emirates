<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="edi_binding_company_rule" model="ir.access">
        <field name="name">UAE ASP binding company isolation</field>
        <field name="model_id" ref="model_l10n_ae_edi_binding" />
        <field name="operation">crud</field>
        <field name="domain">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="edi_transmission_company_rule" model="ir.access">
        <field name="name">UAE frozen invoice company isolation</field>
        <field name="model_id" ref="model_l10n_ae_edi_transmission" />
        <field name="operation">crud</field>
        <field name="domain">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
