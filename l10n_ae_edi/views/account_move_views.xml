<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="account_move_form_uae_edi" model="ir.ui.view">
        <field name="name">account.move.form.uae.edi</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='taxable_supply_date']" position="attributes">
                <attribute name="readonly">
                    state != 'draft' or l10n_ae_received_document
                </attribute>
            </xpath>
            <xpath
                expr="//field[@name='invoice_line_ids']/list/field[@name='tax_ids']"
                position="before"
            >
                <field
                    name="l10n_ae_edi_rcm_nature_code"
                    column_invisible="parent.country_code != 'AE'"
                    readonly="parent.l10n_ae_transmission_id or parent.l10n_ae_received_document"
                    optional="hide"
                />
                <field
                    name="l10n_ae_edi_rcm_standard_id"
                    column_invisible="parent.country_code != 'AE'"
                    readonly="parent.l10n_ae_transmission_id or parent.l10n_ae_received_document"
                    optional="hide"
                />
            </xpath>
            <xpath expr="//form/header" position="inside">
                <button
                    name="action_l10n_ae_validate"
                    type="object"
                    string="Check UAE Data"
                    groups="account.group_account_invoice"
                    invisible="country_code != 'AE' or move_type == 'entry' or l10n_ae_received_document or (move_type not in ('out_invoice', 'out_refund') and not (move_type in ('in_invoice', 'in_refund') and is_self_billing))"
                />
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page
                    string="UAE E-Invoicing"
                    name="uae_edi"
                    invisible="country_code != 'AE' or move_type == 'entry' or (not l10n_ae_received_document and (move_type not in ('out_invoice', 'out_refund') and not (move_type in ('in_invoice', 'in_refund') and is_self_billing)))"
                >
                    <group>
                        <button
                            name="action_l10n_ae_prepare"
                            type="object"
                            string="Prepare UAE E-Invoice"
                            colspan="2"
                            groups="account.group_account_invoice"
                            invisible="state != 'posted' or l10n_ae_received_document or l10n_ae_transmission_id or (move_type not in ('out_invoice', 'out_refund') and not (move_type in ('in_invoice', 'in_refund') and is_self_billing))"
                        />
                        <field
                            name="l10n_ae_binding_id"
                            domain="[('company_id', '=', company_id), ('environment', '=', 'sandbox')]"
                            readonly="l10n_ae_transmission_id"
                            invisible="l10n_ae_received_document"
                        />
                        <field name="l10n_ae_preparation_state" readonly="True" />
                        <field
                            name="l10n_ae_preparation_error"
                            readonly="True"
                            invisible="l10n_ae_preparation_state != 'review'"
                        />
                        <field
                            name="l10n_ae_preparation_review_at"
                            readonly="True"
                            invisible="l10n_ae_preparation_state != 'review'"
                        />
                        <field name="l10n_ae_transmission_id" readonly="True" />
                        <field name="l10n_ae_submission_state" readonly="True" />
                        <button
                            name="action_l10n_ae_start_local_correction"
                            type="object"
                            string="Correct Before Sending"
                            colspan="2"
                            groups="account.group_account_invoice"
                            invisible="state != 'posted' or not l10n_ae_transmission_id or l10n_ae_submission_state != 'queued'"
                        />
                        <field
                            name="l10n_ae_correction_id"
                            invisible="not l10n_ae_correction_id"
                        />
                        <field
                            name="l10n_ae_received_document"
                            readonly="True"
                            invisible="not l10n_ae_received_document"
                        />
                        <field
                            name="l10n_ae_document_category"
                            readonly="l10n_ae_transmission_id or l10n_ae_received_document"
                        />
                        <field
                            name="l10n_ae_received_process"
                            invisible="not l10n_ae_received_document"
                        />
                        <field
                            name="l10n_ae_received_agreement_reference"
                            invisible="l10n_ae_received_process != 'selfbilling'"
                        />
                        <field name="l10n_ae_fiscal_uuid" readonly="True" />
                        <field name="is_self_billing" invisible="True" />
                        <field
                            name="l10n_ae_selfbilling_agreement_id"
                            domain="[('company_id', '=', company_id), ('partner_id', '=', commercial_partner_id)]"
                            invisible="not is_self_billing and l10n_ae_received_process != 'selfbilling'"
                            readonly="l10n_ae_transmission_id or l10n_ae_received_document"
                        />
                        <field
                            name="l10n_ae_credit_reason"
                            invisible="move_type not in ('out_refund', 'in_refund')"
                            readonly="l10n_ae_transmission_id or l10n_ae_received_document"
                        />
                        <field
                            name="l10n_ae_free_zone"
                            readonly="l10n_ae_transmission_id or l10n_ae_received_document"
                        />
                        <field
                            name="l10n_ae_disclosed_agent"
                            readonly="l10n_ae_transmission_id or l10n_ae_received_document"
                        />
                        <field
                            name="l10n_ae_principal_id"
                            invisible="not l10n_ae_disclosed_agent and not l10n_ae_principal_id"
                            readonly="l10n_ae_transmission_id or l10n_ae_received_document"
                        />
                        <field
                            name="l10n_ae_deemed_supply"
                            readonly="l10n_ae_transmission_id or l10n_ae_received_document"
                        />
                        <field
                            name="l10n_ae_margin_scheme"
                            readonly="l10n_ae_transmission_id or l10n_ae_received_document"
                        />
                        <field
                            name="l10n_ae_summary"
                            readonly="l10n_ae_transmission_id or l10n_ae_received_document"
                        />
                        <field
                            name="l10n_ae_invoicing_period_start"
                            readonly="l10n_ae_transmission_id or l10n_ae_received_document"
                        />
                        <field
                            name="l10n_ae_invoicing_period_end"
                            readonly="l10n_ae_transmission_id or l10n_ae_received_document"
                        />
                        <field
                            name="l10n_ae_billing_frequency_code"
                            readonly="l10n_ae_transmission_id or l10n_ae_received_document"
                        />
                        <field
                            name="l10n_ae_billing_frequency_note"
                            invisible="l10n_ae_billing_frequency_code != 'OTH'"
                            readonly="l10n_ae_transmission_id or l10n_ae_received_document"
                        />
                        <field
                            name="l10n_ae_exports"
                            readonly="l10n_ae_transmission_id or l10n_ae_received_document"
                        />
                        <field
                            name="l10n_ae_ecommerce"
                            readonly="l10n_ae_transmission_id or l10n_ae_received_document"
                        />
                        <field
                            name="l10n_ae_beneficiary_id"
                            invisible="not l10n_ae_free_zone"
                            readonly="l10n_ae_transmission_id or l10n_ae_received_document"
                        />
                    </group>
                    <group
                        string="Local Sending Review"
                        invisible="not l10n_ae_dispatch_review_required"
                    >
                        <field
                            name="l10n_ae_dispatch_review_required"
                            readonly="True"
                        />
                        <field name="l10n_ae_dispatch_error_kind" readonly="True" />
                        <field name="l10n_ae_dispatch_review_at" readonly="True" />
                        <label
                            for="l10n_ae_dispatch_review_required"
                            colspan="2"
                            string="Automatic sending is paused for this document. Use Validate UAE E-Invoice to review the preserved document."
                        />
                    </group>
                    <group
                        string="Reviewed Buyer Onboarding"
                        invisible="l10n_ae_received_document"
                    >
                        <field
                            name="l10n_ae_buyer_not_implemented"
                            readonly="l10n_ae_transmission_id or l10n_ae_received_document"
                        />
                        <field
                            name="l10n_ae_export_buyer_no_peppol"
                            invisible="not l10n_ae_exports"
                            readonly="l10n_ae_transmission_id or l10n_ae_received_document"
                        />
                        <field
                            name="l10n_ae_buyer_onboarding_review_date"
                            invisible="not l10n_ae_buyer_not_implemented and not l10n_ae_export_buyer_no_peppol"
                            readonly="l10n_ae_transmission_id or l10n_ae_received_document"
                        />
                        <field
                            name="l10n_ae_buyer_onboarding_review_reference"
                            invisible="not l10n_ae_buyer_not_implemented and not l10n_ae_export_buyer_no_peppol"
                            readonly="l10n_ae_transmission_id or l10n_ae_received_document"
                        />
                        <label
                            for="l10n_ae_buyer_not_implemented"
                            colspan="2"
                            string="This buyer needs a conventional invoice. Fiscal confirmations do not prove its delivery."
                            invisible="not l10n_ae_buyer_not_implemented or move_type != 'out_invoice' or l10n_ae_document_category != 'tax'"
                        />
                        <button
                            name="action_l10n_ae_generate_conventional_pdf"
                            type="object"
                            string="Generate Conventional PDF"
                            groups="account.group_account_invoice"
                            invisible="not l10n_ae_transmission_id or not l10n_ae_buyer_not_implemented or move_type != 'out_invoice' or l10n_ae_document_category != 'tax'"
                        />
                    </group>
                    <group
                        string="Effective AED Conversion"
                        invisible="l10n_ae_received_document or l10n_ae_effective_tax_exchange_origin == 'not_applicable'"
                    >
                        <field
                            name="l10n_ae_effective_tax_exchange_rate"
                            readonly="True"
                        />
                        <field
                            name="l10n_ae_effective_tax_exchange_date"
                            readonly="True"
                        />
                        <field
                            name="l10n_ae_effective_tax_exchange_conversion_date"
                            readonly="True"
                        />
                        <field
                            name="l10n_ae_effective_tax_exchange_source"
                            readonly="True"
                        />
                        <field
                            name="l10n_ae_effective_tax_exchange_origin"
                            readonly="True"
                        />
                        <field
                            name="l10n_ae_effective_cbuae_review_id"
                            readonly="True"
                            invisible="not l10n_ae_effective_cbuae_review_id"
                            options="{'no_create': True}"
                        />
                        <field
                            name="l10n_ae_effective_tax_exchange_diagnostic"
                            readonly="True"
                            invisible="not l10n_ae_effective_tax_exchange_diagnostic"
                        />
                    </group>
                    <group
                        string="Reviewed Fiscal Exchange Rate to AED"
                        invisible="l10n_ae_received_document"
                    >
                        <field
                            name="l10n_ae_tax_exchange_rate"
                            readonly="l10n_ae_transmission_id or l10n_ae_received_document"
                        />
                        <field
                            name="l10n_ae_tax_exchange_date"
                            readonly="l10n_ae_transmission_id or l10n_ae_received_document"
                        />
                        <field
                            name="l10n_ae_tax_exchange_source"
                            readonly="l10n_ae_transmission_id or l10n_ae_received_document"
                        />
                        <label
                            for="l10n_ae_tax_exchange_rate"
                            string="For foreign currency: AED per one unit; preserve the reviewed source value."
                        />
                        <label
                            for="l10n_ae_tax_exchange_source"
                            string="Leave all three override fields empty to use the dated Odoo conversion. A manual reference does not verify CBUAE origin."
                        />
                    </group>
                    <group
                        string="Amounts Declared by the Sender"
                        invisible="not l10n_ae_received_document"
                    >
                        <field name="l10n_ae_received_currency_id" />
                        <field name="l10n_ae_received_prepaid_amount" />
                        <field name="l10n_ae_received_payable_amount" />
                        <field name="l10n_ae_received_fiscal_currency_id" />
                        <field name="l10n_ae_received_tax_exchange_rate" />
                        <field name="l10n_ae_received_tax_amount" />
                        <field name="l10n_ae_received_tax_inclusive_amount" />
                        <label
                            for="l10n_ae_received_payable_amount"
                            string="Review these declared amounts; local payments are not imported."
                        />
                    </group>
                    <group
                        string="UAE Issue History"
                        col="1"
                        invisible="not l10n_ae_transmission_ids"
                    >
                        <field
                            name="l10n_ae_transmission_ids"
                            readonly="True"
                            nolabel="1"
                        >
                            <list create="0" edit="0" delete="0">
                                <field name="revision" />
                                <field name="submission_state" />
                                <field name="local_correction_id" />
                            </list>
                        </field>
                        <label
                            for="l10n_ae_transmission_ids"
                            string="A locally corrected revision stays in this history and is excluded from sending."
                        />
                    </group>
                    <group
                        string="Reviewed Credit Allocations"
                        col="1"
                        invisible="move_type not in ('out_refund', 'in_refund') or l10n_ae_received_document"
                    >
                        <field
                            name="l10n_ae_credit_reference_ids"
                            nolabel="1"
                            readonly="l10n_ae_transmission_id"
                        >
                            <list editable="bottom">
                                <field name="currency_id" column_invisible="True" />
                                <field name="company_id" column_invisible="True" />
                                <field
                                    name="invoice_id"
                                    domain="[('company_id', '=', parent.company_id), ('currency_id', '=', parent.currency_id), ('state', '=', 'posted'), ('move_type', '=', 'in_invoice' if parent.is_self_billing else 'out_invoice')]"
                                    options="{'no_create': True}"
                                />
                                <field name="number" readonly="invoice_id" />
                                <field name="issue_date" readonly="invoice_id" />
                                <field name="allocated_net" />
                                <field name="allocated_tax" />
                                <field name="review_evidence" />
                            </list>
                        </field>
                        <label
                            for="l10n_ae_credit_reference_ids"
                            string="Allocations must match this credit's net and VAT. References do not reconcile accounting."
                        />
                    </group>
                    <group
                        string="E-Invoice Confirmations"
                        invisible="not l10n_ae_transmission_id"
                    >
                        <field name="l10n_ae_exchange_mode" readonly="True" />
                        <field name="l10n_ae_confirmation_state" readonly="True" />
                        <label
                            for="l10n_ae_exchange_mode"
                            colspan="2"
                            string="Reporting Only requires ASP validation and its tax report; buyer ASP exchange does not apply."
                            invisible="l10n_ae_exchange_mode != 'reporting_only'"
                        />
                        <field name="l10n_ae_validation_c2_state" readonly="True" />
                        <field name="l10n_ae_delivery_c3_state" readonly="True" />
                        <field name="l10n_ae_reporting_c2_state" readonly="True" />
                        <field name="l10n_ae_reporting_c3_state" readonly="True" />
                        <field name="l10n_ae_event_review_required" readonly="True" />
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
