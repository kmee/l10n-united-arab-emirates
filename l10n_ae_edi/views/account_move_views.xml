<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="account_move_form_uae_edi" model="ir.ui.view">
        <field name="name">account.move.form.uae.edi</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="inside">
                <button
                    name="action_l10n_ae_validate"
                    type="object"
                    string="Check UAE Data"
                    groups="account.group_account_invoice"
                    invisible="country_code != 'AE' or move_type == 'entry' or l10n_ae_received_document"
                />
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page
                    string="UAE E-Invoicing"
                    name="uae_edi"
                    invisible="country_code != 'AE'"
                >
                    <group>
                        <field
                            name="l10n_ae_binding_id"
                            domain="[('company_id', '=', company_id), ('environment', '=', 'sandbox')]"
                            readonly="l10n_ae_transmission_id"
                        />
                        <field name="l10n_ae_transmission_id" readonly="True" />
                        <field name="l10n_ae_submission_state" readonly="True" />
                        <field
                            name="l10n_ae_received_document"
                            readonly="True"
                            invisible="not l10n_ae_received_document"
                        />
                        <field
                            name="l10n_ae_document_category"
                            readonly="l10n_ae_received_document"
                        />
                        <field name="l10n_ae_fiscal_uuid" readonly="True" />
                        <field name="is_self_billing" invisible="True" />
                        <field
                            name="l10n_ae_selfbilling_agreement_id"
                            domain="[('company_id', '=', company_id), ('partner_id', '=', partner_id)]"
                            invisible="not is_self_billing or l10n_ae_received_document"
                            readonly="l10n_ae_transmission_id"
                        />
                        <field
                            name="l10n_ae_credit_reason"
                            invisible="move_type not in ('out_refund', 'in_refund')"
                            readonly="l10n_ae_received_document"
                        />
                        <field name="l10n_ae_free_zone" />
                        <field
                            name="l10n_ae_beneficiary_id"
                            invisible="not l10n_ae_free_zone"
                            required="l10n_ae_free_zone"
                        />
                    </group>
                    <group
                        string="Amounts Declared by the Sender"
                        invisible="not l10n_ae_received_document"
                    >
                        <field name="l10n_ae_received_currency_id" />
                        <field name="l10n_ae_received_prepaid_amount" />
                        <field name="l10n_ae_received_payable_amount" />
                        <label
                            for="l10n_ae_received_payable_amount"
                            string="Review these declared amounts; local payments are not imported."
                        />
                    </group>
                    <group
                        string="E-Invoice Confirmations"
                        invisible="not l10n_ae_transmission_id"
                    >
                        <field name="l10n_ae_validation_c2_state" readonly="True" />
                        <field name="l10n_ae_delivery_c3_state" readonly="True" />
                        <field name="l10n_ae_reporting_c2_state" readonly="True" />
                        <field name="l10n_ae_reporting_c3_state" readonly="True" />
                        <field name="l10n_ae_event_review_required" readonly="True" />
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
