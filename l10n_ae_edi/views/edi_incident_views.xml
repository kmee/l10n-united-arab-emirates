<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="edi_incident_form" model="ir.ui.view">
        <field name="name">l10n_ae.edi.incident.form</field>
        <field name="model">l10n_ae.edi.incident</field>
        <field name="arch" type="xml">
            <form string="UAE System Incident" duplicate="false">
                <header>
                    <button
                        name="action_open"
                        type="object"
                        string="Open Reviewed Incident"
                        class="btn-primary"
                        groups="account.group_account_manager"
                        invisible="state != 'draft'"
                    />
                    <field name="state" widget="statusbar" readonly="1" />
                </header>
                <sheet>
                    <group>
                        <field name="name" readonly="state == 'open'" />
                        <field
                            name="company_id"
                            readonly="1"
                            options="{'no_create': True, 'no_open': True}"
                        />
                        <field name="affected_roles" readonly="state == 'open'" />
                        <field name="occurrence_at" readonly="state == 'open'" />
                        <field name="detected_at" readonly="state == 'open'" />
                        <field name="reason" readonly="state == 'open'" />
                        <field
                            name="responsible_id"
                            readonly="state == 'open'"
                            options="{'no_create': True, 'no_open': True}"
                        />
                    </group>
                    <group string="Reviewed UAE Calendar">
                        <field name="calendar_start" readonly="state == 'open'" />
                        <field name="calendar_end" readonly="state == 'open'" />
                        <field
                            name="calendar_holiday_dates"
                            string="Federal Holiday Dates"
                            placeholder="One ISO date (YYYY-MM-DD) per line"
                            readonly="state == 'open'"
                        />
                        <field name="calendar_source" readonly="state == 'open'" />
                        <field name="calendar_version" readonly="state == 'open'" />
                        <field name="source_reference" readonly="state == 'open'" />
                        <field name="review_note" readonly="state == 'open'" />
                        <field name="timezone" readonly="1" />
                        <field name="notification_due_date" readonly="1" />
                    </group>
                    <group string="Incident History">
                        <field
                            name="opened_by_id"
                            readonly="1"
                            options="{'no_create': True, 'no_open': True}"
                        />
                        <field name="opened_at" readonly="1" />
                    </group>
                    <p class="text-muted">
                        Opening a reviewed incident schedules one internal reminder for its responsible user. The reminder records an internal action; it does not confirm that a notification was delivered or acknowledged.
                    </p>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>
    <record id="edi_incident_list" model="ir.ui.view">
        <field name="name">l10n_ae.edi.incident.list</field>
        <field name="model">l10n_ae.edi.incident</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field
                    name="company_id"
                    options="{'no_create': True, 'no_open': True}"
                />
                <field name="state" />
                <field name="notification_due_date" />
                <field
                    name="responsible_id"
                    options="{'no_create': True, 'no_open': True}"
                />
                <field name="affected_roles" />
            </list>
        </field>
    </record>
    <record id="edi_incident_action" model="ir.actions.act_window">
        <field name="name">UAE System Incidents</field>
        <field name="res_model">l10n_ae.edi.incident</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem
        id="edi_incident_menu"
        name="UAE System Incidents"
        parent="account.menu_finance_configuration"
        action="edi_incident_action"
        groups="account.group_account_manager"
    />
</odoo>
