<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="edi_binding_form" model="ir.ui.view">
        <field name="name">l10n_ae.edi.binding.form</field>
        <field name="model">l10n_ae.edi.binding</field>
        <field name="arch" type="xml">
            <form string="UAE Provider Binding">
                <header>
                    <button
                        name="action_review_capabilities"
                        type="object"
                        string="Review Contract Capabilities"
                        groups="account.group_account_manager"
                        invisible="environment != 'sandbox'"
                    />
                </header>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="company_id" />
                        <field name="active" />
                        <field name="provider" />
                        <field name="environment" />
                        <field name="fiscal_uuid_policy" />
                        <field name="capability_profile" />
                        <field
                            name="capability_ids"
                            widget="many2many_tags"
                            options="{'no_create': True, 'no_create_edit': True}"
                        />
                        <field name="capability_review_note" />
                        <field name="capability_review_state" />
                        <field name="capability_reviewed_by" />
                        <field name="capability_reviewed_at" />
                        <field name="capability_review_hash" invisible="1" />
                        <field
                            name="controlled_dispatch_enabled"
                            invisible="environment != 'sandbox'"
                        />
                        <field
                            name="controlled_dispatch_error"
                            invisible="not controlled_dispatch_error"
                        />
                        <field
                            name="controlled_dispatch_error_at"
                            invisible="not controlled_dispatch_error"
                        />
                    </group>
                    <div
                        class="text-muted"
                        invisible="fiscal_uuid_policy != 'controlled_local'"
                    >
                        Local UUID assignment is for controlled simulation only.
                        Production UUID allocation requires a verified ASP contract.
                    </div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="edi_binding_list" model="ir.ui.view">
        <field name="name">l10n_ae.edi.binding.list</field>
        <field name="model">l10n_ae.edi.binding</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="company_id" />
                <field name="provider" />
                <field name="environment" />
                <field name="fiscal_uuid_policy" />
                <field name="active" />
                <field name="controlled_dispatch_error" optional="show" />
                <field name="controlled_dispatch_error_at" optional="hide" />
            </list>
        </field>
    </record>
    <record id="edi_binding_action" model="ir.actions.act_window">
        <field name="name">UAE Provider Bindings</field>
        <field name="res_model">l10n_ae.edi.binding</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem
        id="edi_binding_menu"
        name="UAE Provider Bindings"
        parent="account.menu_finance_configuration"
        action="edi_binding_action"
        groups="account.group_account_manager"
        sequence="91"
    />
</odoo>
