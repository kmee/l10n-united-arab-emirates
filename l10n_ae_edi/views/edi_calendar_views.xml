<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="edi_calendar_form" model="ir.ui.view">
        <field name="name">l10n_ae.edi.calendar.form</field>
        <field name="model">l10n_ae.edi.calendar</field>
        <field name="arch" type="xml">
            <form string="Reviewed UAE Calendar Version" duplicate="false">
                <header>
                    <button
                        name="action_approve"
                        type="object"
                        string="Approve Reviewed Version"
                        class="btn-primary"
                        groups="account.group_account_manager"
                        invisible="state != 'draft'"
                    />
                    <field name="state" widget="statusbar" readonly="1" />
                </header>
                <sheet>
                    <group>
                        <field name="name" readonly="state == 'approved'" />
                        <field name="company_id" readonly="1" />
                        <field name="version" readonly="state == 'approved'" />
                        <field name="timezone" readonly="1" />
                        <field name="calendar_start" readonly="state == 'approved'" />
                        <field name="calendar_end" readonly="state == 'approved'" />
                        <field
                            name="calendar_holiday_dates"
                            readonly="state == 'approved'"
                            placeholder="One reviewed ISO date per line"
                        />
                        <field name="source_reference" readonly="state == 'approved'" />
                        <field name="source_snapshot" readonly="state == 'approved'" />
                        <field name="review_note" readonly="state == 'approved'" />
                        <field name="source_sha256" readonly="1" />
                        <field name="approved_by_id" readonly="1" />
                        <field name="approved_at" readonly="1" />
                    </group>
                    <p class="text-muted">
                        Review observed federal holidays and coverage against the retained sources.
                        Saturdays and Sundays are excluded; Friday remains a working day.
                        Approval records your review and preserves the version; it does not authenticate
                        a source or change deadlines of already-opened incidents.
                    </p>
                </sheet>
            </form>
        </field>
    </record>
    <record id="edi_calendar_list" model="ir.ui.view">
        <field name="name">l10n_ae.edi.calendar.list</field>
        <field name="model">l10n_ae.edi.calendar</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="company_id" />
                <field name="version" />
                <field name="calendar_start" />
                <field name="calendar_end" />
                <field name="state" />
                <field name="approved_by_id" />
                <field name="approved_at" />
            </list>
        </field>
    </record>
    <record id="edi_calendar_action" model="ir.actions.act_window">
        <field name="name">UAE Reviewed Calendar Versions</field>
        <field name="res_model">l10n_ae.edi.calendar</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem
        id="edi_calendar_menu"
        name="UAE Reviewed Calendar Versions"
        parent="account.menu_finance_configuration"
        action="edi_calendar_action"
        groups="account.group_account_manager"
    />
</odoo>
