<odoo>
    <record id="product_template_form_uae_classification" model="ir.ui.view">
        <field name="name">product.template.form.uae.classification</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']" position="after">
                <page
                    name="l10n_ae_classification"
                    string="UAE Classification"
                    invisible="'AE' not in fiscal_country_codes"
                >
                    <p
                    >Use the reviewed service accounting code and its scheme version. No code is supplied automatically.</p>
                    <p
                        invisible="not id or is_product_variant or product_variant_count == 1"
                    >Configure classification on each individual variant.</p>
                    <group
                        invisible="not is_product_variant and id and product_variant_count != 1"
                    >
                        <field name="l10n_ae_service_accounting_code" />
                        <field name="l10n_ae_service_accounting_version" />
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
