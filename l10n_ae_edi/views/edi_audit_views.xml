<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <menuitem
        id="edi_audit_root"
        name="UAE Audit"
        groups="l10n_ae_edi.group_fiscal_auditor"
        sequence="95"
    />
    <record id="edi_audit_issue_list" model="ir.ui.view">
        <field name="name">l10n_ae.edi.transmission.audit.list</field>
        <field name="model">l10n_ae.edi.transmission</field>
        <field name="priority" eval="30" />
        <field name="arch" type="xml">
            <list create="false" edit="false" delete="false">
                <field name="origin_document_id" />
                <field name="company_id" options="{'no_open': True}" />
                <field name="process" />
                <field name="revision" />
                <field name="submission_state" />
                <field name="confirmation_state" />
            </list>
        </field>
    </record>
    <record id="edi_audit_issue_form" model="ir.ui.view">
        <field name="name">l10n_ae.edi.transmission.audit.form</field>
        <field name="model">l10n_ae.edi.transmission</field>
        <field name="priority" eval="30" />
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false" duplicate="false">
                <sheet>
                    <group>
                        <field name="origin_system" />
                        <field name="origin_document_id" />
                        <field name="company_id" options="{'no_open': True}" />
                        <field name="process" />
                        <field name="revision" />
                        <field name="provider" />
                        <field name="environment" />
                        <field name="remote_id" />
                        <field name="submission_state" />
                        <field name="validation_c2_state" />
                        <field name="delivery_c3_state" />
                        <field name="reporting_c2_state" />
                        <field name="reporting_c3_state" />
                        <field name="confirmation_state" />
                        <field name="dispatch_review_required" />
                        <field name="dispatch_error_kind" />
                        <field name="dispatch_review_at" />
                        <field name="dispatch_validation_receipt" />
                        <field name="dispatch_policy_receipt" />
                        <field name="payload_hash" />
                        <field name="xml_hash" />
                        <field name="xml_download_filename" invisible="1" />
                        <field
                            name="xml_download"
                            widget="binary"
                            filename="xml_download_filename"
                        />
                        <field name="evidence_archive_filename" invisible="1" />
                        <field
                            name="evidence_archive"
                            widget="binary"
                            filename="evidence_archive_filename"
                            groups="base.group_allow_export"
                        />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="edi_audit_issue_action" model="ir.actions.act_window">
        <field name="name">Issued Documents</field>
        <field name="res_model">l10n_ae.edi.transmission</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="edi_audit_issue_action_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1" />
        <field name="view_mode">list</field>
        <field name="view_id" ref="edi_audit_issue_list" />
        <field name="act_window_id" ref="edi_audit_issue_action" />
    </record>
    <record id="edi_audit_issue_action_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2" />
        <field name="view_mode">form</field>
        <field name="view_id" ref="edi_audit_issue_form" />
        <field name="act_window_id" ref="edi_audit_issue_action" />
    </record>
    <menuitem
        id="edi_audit_issue_menu"
        name="Issued Documents"
        parent="edi_audit_root"
        action="edi_audit_issue_action"
        sequence="1"
    />
