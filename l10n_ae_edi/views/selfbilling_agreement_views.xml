<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="selfbilling_agreement_form" model="ir.ui.view">
        <field name="name">l10n_ae.selfbilling.agreement.form</field>
        <field name="model">l10n_ae.selfbilling.agreement</field>
        <field name="arch" type="xml">
            <form string="UAE Self-Billing Agreement">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="company_id" />
                        <field name="partner_id" />
                        <field name="local_role" />
                        <field name="active" />
                        <field name="start_date" />
                        <field name="end_date" />
                        <field name="scope" />
                        <field name="onboarding_reference" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="selfbilling_agreement_list" model="ir.ui.view">
        <field name="name">l10n_ae.selfbilling.agreement.list</field>
        <field name="model">l10n_ae.selfbilling.agreement</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="company_id" />
                <field name="partner_id" />
                <field name="local_role" />
                <field name="start_date" />
                <field name="end_date" />
                <field name="active" />
            </list>
        </field>
    </record>
</odoo>
