<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="edi_incident_impact_wizard_form" model="ir.ui.view">
        <field name="name">l10n_ae.edi.incident.impact.wizard.form</field>
        <field name="model">l10n_ae.edi.incident.impact.wizard</field>
        <field name="arch" type="xml">
            <form string="Review Affected Documents">
                <group>
                    <field
                        name="incident_id"
                        options="{'no_create': True, 'no_open': True}"
                    />
                    <field name="company_id" invisible="1" />
                    <field
                        name="transmission_ids"
                        widget="many2many_tags"
                        domain="[('company_id', '=', company_id)]"
                        options="{'no_create': True, 'no_create_edit': True}"
                    />
                    <field name="source_reference" />
                    <field name="review_note" />
                </group>
                <p class="text-muted">
                    Select the original documents affected by this failure. Recording this reviewed batch preserves their identities and does not send them. Add later affected documents in another reviewed batch.
                </p>
                <footer>
                    <button
                        name="action_confirm"
                        string="Record Reviewed Impact"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
    <record id="edi_incident_restoration_wizard_form" model="ir.ui.view">
        <field name="name">l10n_ae.edi.incident.restoration.wizard.form</field>
        <field name="model">l10n_ae.edi.incident.restoration.wizard</field>
        <field name="arch" type="xml">
            <form string="Review Service Restoration">
                <group>
                    <field
                        name="incident_id"
                        options="{'no_create': True, 'no_open': True}"
                    />
                    <field name="evidence_origin" />
                    <field name="restored_at" />
                    <field name="source_reference" />
                    <field name="review_note" />
                </group>
                <p class="text-muted">
                    Times are shown in your Odoo time zone. Review the declared restoration against the failure occurrence. This records a local declaration; pending submissions and fiscal confirmations remain separate obligations.
                </p>
                <footer>
                    <button
                        name="action_confirm"
                        string="Record Restoration Review"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
