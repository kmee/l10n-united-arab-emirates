<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="edi_incident_confirmation_wizard_form" model="ir.ui.view">
        <field name="name">l10n_ae.edi.incident.confirmation.wizard.form</field>
        <field name="model">l10n_ae.edi.incident.confirmation.wizard</field>
        <field name="arch" type="xml">
            <form string="Record Original FTA Confirmation">
                <group>
                    <field
                        name="incident_id"
                        options="{'no_create': True, 'no_open': True}"
                    />
                    <field name="evidence_origin" />
                    <field name="received_at" />
                    <field name="external_reference" />
                    <field name="source_reference" />
                    <field name="review_note" />
                    <field name="document_filename" />
                    <field name="document" filename="document_filename" />
                </group>
                <p class="text-muted">
                    Supply the original confirmation, up to 10 MiB. Times use your Odoo time zone; the deadline uses Asia/Dubai. Recording fixes the reviewed receipt basis and preserves the file. It does not verify FTA authorship or delivery and does not notify the ASP.
                </p>
                <footer>
                    <button
                        name="action_confirm"
                        string="Record Reviewed Confirmation"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
